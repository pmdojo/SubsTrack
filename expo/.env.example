# Copy to .env.local and fill in real values. Never commit .env.local.
# All EXPO_PUBLIC_* vars are inlined at build time and shipped to the client
# (the Supabase anon key is meant to be public — RLS enforces security).

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# 'development' | 'staging' | 'production'
EXPO_PUBLIC_ENV=development

# Console logging switch — set to 'false' in production if noisy
EXPO_PUBLIC_LOG_ENABLED=true

# Optional — Phase 8 observability
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_POSTHOG_KEY=
